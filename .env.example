# Chave do Gemini: https://aistudio.google.com
GEMINI_API_KEY=

# Chave da Tavily, usada nas pesquisas na web: https://app.tavily.com
TAVILY_API_KEY=

# Modelos em ordem de preferência, usados no roteador e nas respostas
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash

# Opcionais (os valores abaixo são os padrões)
# Tempo limite de cada tentativa, em milissegundos
GEMINI_TIMEOUT_MS=25000
# Como o Jarvis chama o usuário: senhor ou senhora
JARVIS_TRATAMENTO=senhor
